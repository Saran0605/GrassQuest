# Express Server Configuration
PORT=5000

# Google AI Studio API Key (for Gemini/Gemma model)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-2-27b-it

# Optional: MongoDB Atlas URI for saving generated quest cards
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/grassquest?retryWrites=true&w=majority
